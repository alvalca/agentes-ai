# ============================================================================
# .env.example — Copia este archivo a .env y rellena los valores
# cp .env.example .env
# ============================================================================

# ── Secretos obligatorios ────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-segura

ADMIN_USER=admin
ADMIN_PASS=cambia-esta-contraseña

# ── API keys opcionales ───────────────────────────────────────────────────────
# Brave Search: plan gratuito en https://api.search.brave.com (2000 búsquedas/mes)
# Si no se configura, el sistema usa DuckDuckGo como fallback automático
BRAVE_API_KEY=

# HuggingFace: solo necesario para modelos privados/gated
# HF_TOKEN=

# ── Rutas del sistema (privadas — no subir a git) ─────────────────────────────
# Solo necesitas añadir las que difieran de los valores por defecto del script.
# El script detecta automáticamente LM Studio en las ubicaciones más comunes.

# PROJECT_DIR=/ruta/a/tu/proyecto/agentes
# MAMBA_DIR=/ruta/a/tu/instalacion/de/mamba
# LMS=/home/usuario/.lmstudio/bin/lms
# LM_STUDIO_APP=/home/usuario/Applications/lm-studio.AppImage

# ── Suprimir warnings de HuggingFace ─────────────────────────────────────────
TRANSFORMERS_OFFLINE=1
TQDM_DISABLE=1

# ── Overrides opcionales (los defaults están en config.py) ───────────────────
# LM_STUDIO_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=local-model
# EMBED_DEVICE=cuda:1
# RERANKER_DEVICE=cuda:1
# RERANKER_ENABLED=true
