# ── Dockerfile.frontend ───────────────────────────────────────────────────────
# Frontend: Streamlit UI
# Imagen más ligera que el backend — no necesita ML ni pandoc
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Solo las dependencias que necesita Streamlit
COPY requirements.frontend.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.frontend.txt

# Copiar solo el frontend y config
COPY frontend/ ./frontend/
COPY config.py .

# Puerto de Streamlit
EXPOSE 8501

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Streamlit necesita estas variables para modo headless (sin navegador)
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

CMD ["streamlit", "run", "frontend/app.py", \
     "--server.port", "8501", \
     "--server.address", "0.0.0.0", \
     "--server.headless", "true", \
     "--browser.gatherUsageStats", "false"]
